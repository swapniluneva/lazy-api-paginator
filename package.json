{
  "name": "lazy-api-paginator",
  "version": "1.0.1",
  "description": "A lazy-loading API paginator with async generators, exponential retry, and lifecycle hooks",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "homepage": "https://github.com/swapniluneva/lazy-api-paginator#readme",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "api",
    "paginator",
    "pagination",
    "lazy-loading",
    "generator",
    "iterator",
    "async-iterator",
    "retry",
    "exponential-backoff"
  ],
  "author": {
    "name": "Swapnil Srivastava",
    "email": "srivastava.swapnil99@gmail.com",
    "url": "https://swapniluneva.github.io"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swapniluneva/lazy-api-paginator.git"
  },
  "bugs": {
    "url": "https://github.com/swapniluneva/lazy-api-paginator/issues"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^1.0.0",
    "ssrf-agent-guard": "^0.1.12",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "ssrf-agent-guard": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "ssrf-agent-guard": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
